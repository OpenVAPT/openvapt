# openvapt.com public site. Public launch approved by the owner 2026-10-13.
# Everything is public here for every channel (Alpha, Beta, RC, Stable); the
# old /beta/ preview was retired on 2026-10-13 and no longer exists (410 Gone).
# The old /tools/ admin endpoint was retired on 2026-10-14 (moved to
# to-be-deleted); /tools/ now answers 410 Gone and no path is exempt from the
# header and PHP rules below.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Every text response declares UTF-8 in its Content-Type header as well as in
# the page itself.
AddDefaultCharset utf-8
# No server version or module list in error pages.
ServerSignature Off

# Citation files offered on /cite.html.
AddType application/x-research-info-systems .ris
AddType application/x-bibtex .bib
AddType text/plain .cff
# Sample reports and Markdown documents.
AddType application/sarif+json .sarif
AddType text/markdown .md
# Web app manifest and the Atom feed.
AddType application/manifest+json .webmanifest
AddType application/atom+xml .atom

<IfModule mod_rewrite.c>
  RewriteEngine On
  # One canonical origin: https://openvapt.com. Plain HTTP and every other
  # host name that reaches this site (www., mail., autoconfig. and the rest)
  # redirect to the apex over HTTPS.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^openvapt\.com$ [NC]
  RewriteRule ^ https://openvapt.com%{REQUEST_URI} [R=301,L]
  # The retired /beta/ preview no longer exists: answer 410 Gone, no redirect.
  RewriteRule ^beta(?:/.*)?$ - [G,L]
  RewriteRule ^tools(?:/.*)?$ - [G,L]
  # One address per page: /index.html redirects to its directory form, which
  # is what every canonical tag names. Only an explicit request is rewritten,
  # never the DirectoryIndex lookup.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://openvapt.com/$1 [R=301,L]
  # RFC 9116: the well-known location is canonical; the legacy root path
  # redirects to it.
  RewriteRule ^security\.txt$ /.well-known/security.txt [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
  # Markdown twins of pages (checks/*.md, academy/*.md, faq.md, glossary.md)
  # and the sample Markdown reports are for readers, scripts and AI tools; the
  # HTML page is the one address search engines should index.
  <FilesMatch "\.md$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  # The site sets no cookies; make sure nothing upstream does either.
  Header always unset Set-Cookie
  # Caching. Pages, feeds and crawler files are revalidated on every visit so
  # a deploy is seen at once; fonts and the vendored libraries (versioned by
  # package, replaced only with a new file) are kept for a year; the site's
  # own CSS, scripts and images for a week.
  <FilesMatch "\.(html|xml|txt|json|md|sarif|bib|ris|cff|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# The vendored libraries live under their own folder and change only when the
# vendored file changes, so they may be cached for a year.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/vendor/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Compress the sample report formats the server does not compress by default.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml application/manifest+json application/sarif+json text/markdown application/x-bibtex application/x-research-info-systems
  </IfModule>
</IfModule>

# RFC 9116 security.txt is plain text, UTF-8.
<Files "security.txt">
  ForceType text/plain
</Files>

# The public site is static. Refuse to run server-side code anywhere.
<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
